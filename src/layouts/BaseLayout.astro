---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SearchModal from '../components/ui/SearchModal.astro';
import { DEFAULT_SITE_DESCRIPTION } from '../lib/site';
import { DEFAULT_LOCALE, LOCALE_INFO, LOCALES, getLocale, localePath, type Alternates } from '../lib/i18n';

interface Props {
    title: string;
    description?: string;
    image?: string;
    imageWidth?: number;
    imageHeight?: number;
    /** URLs dieser Seite in anderen Sprachen (inkl. der aktuellen). Fehlt = nur diese Sprache. */
    alternates?: Alternates;
}

const locale = getLocale(Astro.url);
const {title, description = DEFAULT_SITE_DESCRIPTION, image, imageWidth, imageHeight} = Astro.props;
// Gleiche Form wie die Canonical-URL (Verzeichnis mit Slash).
const withSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const alternates: Alternates = Object.fromEntries(
    Object.entries({...Astro.props.alternates, [locale]: Astro.url.pathname}).map(([l, path]) => [l, withSlash(path!)]),
);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const info = LOCALE_INFO[locale];
// Suchmaschinen bekommen nur echte Sprachfassungen, nicht die Spaß-Fassung.
const hreflangs = LOCALES.filter((l) => LOCALE_INFO[l].hreflang && alternates[l]);
const rssPath = localePath(locale === 'pott' ? DEFAULT_LOCALE : locale, '/rss.xml');
---

<!doctype html>
<html lang={info.htmlLang} class="antialiased">
<head>
    <meta charset="utf-8"/>
    <!-- Tell the browser up front that both schemes exist, so its default canvas
         (shown while the render-blocking stylesheets load and between page
         navigations) follows the system theme instead of flashing white. -->
    <meta name="color-scheme" content="light dark"/>
    <!-- Browser UI color; the theme script below sets it to the effective theme -->
    <meta name="theme-color" content="#f3f4f0"/>

    <!-- Critical theme colors, inlined so the first paint never waits for global.css -->
    <style is:inline>
        html { background-color: #f3f4f0; color-scheme: light; }
        html.dark { background-color: #0e1113; color-scheme: dark; }
    </style>

    <!-- Dark mode: inline script runs before any stylesheet is requested to prevent flash -->
    <script is:inline>
    (function() {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', stored || 'system');
        var dark = stored === 'dark' || (!stored && prefersDark);
        document.documentElement.classList.toggle('dark', dark);
        document.querySelector('meta[name="theme-color"]').setAttribute('content', dark ? '#0e1113' : '#f3f4f0');
        // Enable color transitions after the first paint to avoid initial-load flash
        window.addEventListener('load', function () {
            requestAnimationFrame(function () {
                document.documentElement.classList.add('theme-loaded');
            });
        });
    })();
    </script>

    <!-- Sprache: gespeicherte Wahl > Browser-Sprache. Läuft vor dem ersten Paint, damit nichts
         flackert. Automatisch nur beim Einstieg von außen und nie für Crawler, sonst sähe
         Googlebot (en-US) jede deutsche Seite als Weiterleitung. -->
    <script is:inline define:vars={{alternates, currentLocale: locale}}>
    (function () {
        var auto = ['de', 'en', 'fr', 'nl', 'sv', 'nb'];
        function detect() {
            var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
            for (var i = 0; i < langs.length; i++) {
                var base = String(langs[i]).toLowerCase().split('-')[0];
                if (base === 'no' || base === 'nn') base = 'nb';
                if (auto.indexOf(base) !== -1) return base;
            }
            return 'en';
        }
        window.__detectLocale = detect;
        var target = null;
        try { target = localStorage.getItem('locale'); } catch (e) {}
        if (!target) {
            if (/bot|crawl|spider|slurp|preview|lighthouse|headless/i.test(navigator.userAgent)) return;
            try { if (document.referrer && new URL(document.referrer).origin === location.origin) return; } catch (e) {}
            target = detect();
        }
        if (target !== currentLocale && alternates[target]) location.replace(alternates[target] + location.search + location.hash);
    })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png"/>
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png"/>
    <link rel="icon" href="/favicon.ico" sizes="any"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="sitemap" href="/sitemap-index.xml"/>
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href={rssPath}/>
    <link rel="canonical" href={canonicalURL}/>
    {hreflangs.length > 1 && hreflangs.map((l) => (
        <link rel="alternate" hreflang={LOCALE_INFO[l].hreflang} href={new URL(alternates[l]!, Astro.site)}/>
    ))}
    {hreflangs.length > 1 && alternates.de && <link rel="alternate" hreflang="x-default" href={new URL(alternates.de, Astro.site)}/>}
    {locale === 'pott' && <meta name="robots" content="noindex"/>}

    <title>{title}</title>
    <meta name="description" content={description}/>
    <meta name="generator" content={Astro.generator}/>

    <!-- Open Graph -->
    <meta property="og:type" content={image ? "article" : "website"}/>
    <meta property="og:url" content={canonicalURL}/>
    <meta property="og:locale" content={info.ogLocale}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    {image && <meta property="og:image" content={new URL(image, Astro.site)}/>}
    {image && imageWidth && <meta property="og:image:width" content={String(imageWidth)}/>}
    {image && imageHeight && <meta property="og:image:height" content={String(imageHeight)}/>}

    <!-- Twitter / X -->
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"}/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    {image && <meta name="twitter:image" content={new URL(image, Astro.site)}/>}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link
            href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400..700&family=Atkinson+Hyperlegible+Next:ital,wght@0,400..700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap"
            rel="stylesheet"
    />

</head>
<body class="bg-(--color-bg) text-(--color-text) min-h-screen flex flex-col">
<Header alternates={alternates}/>
<main class="flex-1">
    <slot/>
</main>
<Footer/>
<SearchModal/>

<!-- External links: open in new tab -->
<script is:inline>
document.querySelectorAll('a[href^="http"]').forEach(function (a) {
    if (a.hostname !== location.hostname) {
        a.setAttribute('target', '_blank');
        a.setAttribute('rel', 'noopener noreferrer');
    }
});
</script>

<!-- Image zoom -->
<script is:inline>
document.addEventListener('click', function (e) {
    var img = e.target.closest('[data-zoomable]');
    if (!img) return;

    var overlay = document.createElement('div');
    overlay.className = 'image-zoom-overlay';

    var clone = document.createElement('img');
    clone.src = img.currentSrc || img.src;
    clone.alt = img.alt;

    overlay.appendChild(clone);
    document.body.appendChild(overlay);

    requestAnimationFrame(function () {
        requestAnimationFrame(function () { overlay.classList.add('active'); });
    });

    function close() {
        overlay.classList.remove('active');
        overlay.addEventListener('transitionend', function () { overlay.remove(); }, { once: true });
        document.removeEventListener('keydown', onKey);
    }

    function onKey(ev) {
        if (ev.key === 'Escape') close();
    }

    overlay.addEventListener('click', close);
    document.addEventListener('keydown', onKey);
});
</script>
</body>
</html>
