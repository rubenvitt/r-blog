---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TagBadge from '../components/ui/TagBadge.astro';
import ReadingProgress from '../components/ui/ReadingProgress.astro';
import PodcastPlayer from '../components/widgets/PodcastPlayer.astro';
import AiDisclosure from '../components/ui/AiDisclosure.astro';

interface Props {
    title: string;
    description: string;
    date: Date;
    updatedDate?: Date;
    tags?: string[];
    image?: ImageMetadata;
    podcast?: {audioFile: string; transcript?: string};
    ai?: 'generated' | 'assisted' | 'none';
}

const {title, description, date, updatedDate, tags = [], image, podcast, ai = 'generated'} = Astro.props;

const formattedDate = date.toISOString().slice(0, 10);
const formattedUpdatedDate = updatedDate?.toISOString().slice(0, 10);

// Rough reading time estimate
const content = await Astro.slots.render('default');
const words = content.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(words / 200));
---

<BaseLayout title={`${title} — rubeen.dev`} description={description} image={image?.src} imageWidth={image?.width} imageHeight={image?.height}>
    <ReadingProgress readingTime={readingTime} />
    <!-- Hero Header -->
    {image ? (
        <div class="relative min-h-[50vh] flex items-end text-white overflow-hidden">
            <Image
                src={image}
                alt=""
                class="absolute inset-0 w-full h-full object-cover brightness-[0.4] saturate-[0.8]"
                widths={[800, 1200, 1600]}
                sizes="100vw"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent" />
            <div class="relative z-10 mx-auto w-full max-w-(--content-width-wide) px-6 pb-12 pt-24">
                <div class="max-w-(--content-width)">
                    {tags.length > 0 && (
                        <div class="flex flex-wrap gap-2 mb-4">
                            {tags.map((tag) => (
                                <TagBadge tag={tag} variant="hero"/>
                            ))}
                        </div>
                    )}
                    <h1 class="post-title text-[2.25rem] leading-[1.1] tracking-[-0.03em] sm:text-[2.75rem]">
                        {title}
                    </h1>
                    <p class="mt-4 max-w-[60ch] text-xl leading-relaxed text-white/75">
                        {description}
                    </p>
                    <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.8125rem] tracking-[0.02em] text-white/65">
                        <time datetime={date.toISOString()}>{formattedDate}</time>
                        <span>&middot;</span>
                        <span>{readingTime} min Lesezeit</span>
                        {formattedUpdatedDate && (
                            <>
                                <span>&middot;</span>
                                <span>Aktualisiert {formattedUpdatedDate}</span>
                            </>
                        )}
                    </div>
                </div>
            </div>
        </div>
    ) : (
        <div class="border-b border-(--color-border)">
            <div class="mx-auto max-w-(--content-width) px-6 pt-16 pb-10">
                <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.8125rem] tracking-[0.02em] text-(--color-text-secondary)">
                    <time datetime={date.toISOString()}>{formattedDate}</time>
                    <span class="text-(--color-border-strong)">&middot;</span>
                    <span>{readingTime} min Lesezeit</span>
                    {formattedUpdatedDate && (
                        <>
                            <span class="text-(--color-border-strong)">&middot;</span>
                            <span>Aktualisiert {formattedUpdatedDate}</span>
                        </>
                    )}
                </div>
                <h1 class="post-title text-[2.25rem] leading-[1.1] tracking-[-0.03em] sm:text-[2.75rem]">
                    {title}
                </h1>
                <p class="mt-4 max-w-[60ch] text-xl leading-relaxed text-(--color-text-secondary)">
                    {description}
                </p>
                {tags.length > 0 && (
                    <div class="mt-5 flex flex-wrap gap-2">
                        {tags.map((tag) => (
                            <TagBadge tag={tag}/>
                        ))}
                    </div>
                )}
            </div>
        </div>
    )}

    <AiDisclosure level={ai} />

    {podcast && (
        <div class="mx-auto max-w-(--content-width) px-6 pt-8">
            <PodcastPlayer audioFile={podcast.audioFile} transcript={podcast.transcript} title={title} />
            <p class="mt-2 text-xs text-(--color-text-muted)">
                Dialog und Stimmen dieser Audio-Fassung sind vollständig KI-generiert.
            </p>
        </div>
    )}

    <!-- Post Content -->
    <article class="prose mx-auto max-w-(--content-width) px-6 py-12">
        <slot/>
    </article>

    <style>
        .post-title {
            font-weight: 700;
            font-variation-settings: 'opsz' 72;
        }
    </style>

    <!-- Heading anchor links -->
    <script is:inline>
    document.querySelectorAll('article.prose h2[id], article.prose h3[id]').forEach(function(heading) {
        var anchor = document.createElement('a');
        anchor.className = 'heading-anchor';
        anchor.href = '#' + heading.id;
        anchor.textContent = '#';
        anchor.setAttribute('aria-hidden', 'true');
        heading.prepend(anchor);
    });
    </script>
</BaseLayout>
