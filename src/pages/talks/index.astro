---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TalkRow from '../../components/talks/TalkRow.astro';
import { getTalks, splitByDate } from '../../lib/talks';
import { TALKS_PAGE } from '../../lib/site';

const talks = await getTalks();
const { upcoming, past } = splitByDate(talks);
const sections = [
    { key: 'demnaechst', label: 'Demnächst', talks: upcoming },
    { key: 'gehalten', label: 'Gehalten', talks: past },
].filter((s) => s.talks.length > 0);

// Angebote von ai-product-engineering.com (gemeinsam mit Michael Seel, über INNOQ buchbar).
const OFFERS = [
    { duration: '45 min', kind: 'Talk', text: 'was AI-Features produktionstauglich macht' },
    { duration: '8 h', kind: 'Workshop', text: 'ein Agent Contract wächst an einem durchgehenden Beispiel, im gehosteten Lab ohne Installation' },
    { duration: '3 Tage', kind: 'Inhouse-Training', text: 'AI Product Engineering für das eigene Team' },
];
---

<BaseLayout title={TALKS_PAGE.title} description={TALKS_PAGE.description}>
    <div class="mx-auto max-w-(--content-width) px-4 sm:px-6">
        <section class="pt-16 pb-10 sm:pt-20">
            <p class="mb-4 font-mono text-[0.8125rem] tracking-[0.04em] text-(--color-text-secondary)">
                <span class="text-(--color-signal-text)">■</span> {talks.length} {talks.length === 1 ? 'Termin' : 'Termine'}{upcoming.length > 0 && <> · {upcoming.length} demnächst</>}
            </p>
            <h1 class="text-[2.75rem] leading-[1.05] font-bold tracking-[-0.03em] sm:text-[3.5rem]" style="font-variation-settings: 'opsz' 96">
                Talks
            </h1>
            <p class="mt-6 max-w-[56ch] text-xl leading-relaxed text-(--color-text-secondary)">
                Vorträge und Workshops, meistens zu dem, worüber ich auch hier schreibe: wie AI-Features zu Systemen werden, die man testen, beobachten und betreiben kann.
            </p>
        </section>

        {sections.map((section) => (
            <section id={section.key} class="scroll-mt-20 pb-10">
                <h2 class="mb-2 text-[1.875rem] leading-tight font-semibold tracking-[-0.02em]" style="font-variation-settings: 'opsz' 48">
                    {section.label}
                </h2>
                <div class="border-b border-(--color-border)">
                    {section.talks.map((talk) => <TalkRow talk={talk} />)}
                </div>
            </section>
        ))}

        <section id="auf-anfrage" class="scroll-mt-20 pb-16">
            <h2 class="mb-2 text-[1.875rem] leading-tight font-semibold tracking-[-0.02em]" style="font-variation-settings: 'opsz' 48">
                Auf Anfrage
            </h2>
            <p class="max-w-[62ch] text-base leading-relaxed text-(--color-text-secondary)">
                Hinter den meisten Terminen steht dasselbe Thema: AI Product Engineering, also wie ein KI-Feature als Teil der Software in Produktion trägt, mit Agent Contract, Evals, Freigabestufen und Observability. Michael Seel und ich haben es gemeinsam entwickelt und bieten es über INNOQ auch für Teams an.
            </p>
            <div class="mt-4 border-b border-(--color-border)">
                {OFFERS.map((offer) => (
                    <div class="grid gap-x-6 gap-y-1 border-t border-(--color-border) py-4 sm:grid-cols-[7rem_1fr]">
                        <span class="font-mono text-[0.8125rem] leading-[1.75rem] tracking-[0.02em] text-(--color-text-secondary) tabular-nums">{offer.duration}</span>
                        <p class="text-base leading-relaxed"><span class="font-semibold text-(--color-text)">{offer.kind}</span> <span class="text-(--color-text-secondary)">· {offer.text}</span></p>
                    </div>
                ))}
            </div>
            <p class="mt-4 font-mono text-[0.8125rem] tracking-[0.02em]">
                <a href="https://ai-product-engineering.com/" class="text-(--color-accent) hover:text-(--color-accent-hover)">↗ ai-product-engineering.com</a>
            </p>
        </section>
    </div>
</BaseLayout>
