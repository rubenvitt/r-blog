---
import TagPage from '../../components/pages/TagPage.astro';
import { getTagPaths } from '../../lib/tags';

export async function getStaticPaths() {
    return (await getTagPaths('de')).map(({tag, posts, locales}) => ({params: {tag}, props: {tag, posts, locales}}));
}
---

<TagPage {...Astro.props}/>
