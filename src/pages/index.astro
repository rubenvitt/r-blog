---
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/ui/PostCard.astro';
import FeaturedProject from '../components/projects/FeaturedProject.astro';
import { HOME_PAGE } from '../lib/site';
import { getProjects } from '../lib/projects';
import TalkRow from '../components/talks/TalkRow.astro';
import { getTalks, splitByDate } from '../lib/talks';

const blogPosts = await getCollection('blog', ({data}) => import.meta.env.DEV || !data.draft);
const externalPosts = await getCollection('extern');
// Blogposts und Artikel an anderer Stelle in einer Liste, neueste zuerst.
const posts = [...blogPosts, ...externalPosts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredProjects = (await getProjects()).filter((p) => p.data.featured).slice(0, 4);
const upcomingTalks = splitByDate(await getTalks()).upcoming.slice(0, 3);
---

<BaseLayout title={HOME_PAGE.title} description={HOME_PAGE.description}>
    <div class="mx-auto max-w-(--content-width) px-4 sm:px-6">
        <!-- Hero: Lagekarten-Raster im Hintergrund, eine Markierung -->
        <section class="relative pt-20 pb-16 sm:pt-24">
            <div class="hero-grid" aria-hidden="true"></div>
            <p class="relative mb-4 font-mono text-[0.8125rem] tracking-[0.04em] text-(--color-text-secondary)">
                <span class="text-(--color-signal-text)">■</span> Software · Teams · Katastrophenschutz
            </p>
            <h1 class="hero-title relative text-[2.75rem] leading-[1.05] tracking-[-0.03em] sm:text-[4rem] sm:leading-none">
                Hey, ich bin <span class="hero-name">Ruben.</span>
            </h1>
            <p class="relative mt-6 max-w-[56ch] text-xl leading-relaxed text-(--color-text-secondary)">
                Ich schreibe über Softwareentwicklung, Zusammenarbeit und pragmatische Lösungen in komplexen Kontexten – aus Projekten, dem Consulting und an der Schnittstelle zum Katastrophenschutz.
            </p>
            <div class="relative mt-8 flex flex-wrap items-center gap-3">
                <a href="#posts" class="inline-flex h-10 items-center rounded-md border border-(--color-accent) bg-(--color-accent) px-4 text-sm font-bold tracking-[0.01em] text-(--color-on-accent) transition-colors hover:border-(--color-accent-hover) hover:bg-(--color-accent-hover)">Neueste Posts lesen</a>
                <a href="/projekte" class="inline-flex h-10 items-center rounded-md border border-(--color-border-strong) bg-(--color-bg-secondary) px-4 text-sm font-bold tracking-[0.01em] text-(--color-text) transition-colors hover:border-(--color-text)">Projekte</a>
                <a href="/about" class="inline-flex h-10 items-center rounded-md border border-(--color-border-strong) bg-(--color-bg-secondary) px-4 text-sm font-bold tracking-[0.01em] text-(--color-text) transition-colors hover:border-(--color-text)">Über mich</a>
            </div>
        </section>

        <!-- Post List -->
        <section id="posts" class="scroll-mt-20 pb-8">
            <h2 class="mb-2 text-[1.875rem] leading-tight font-semibold tracking-[-0.02em]" style="font-variation-settings: 'opsz' 48">
                Neueste Posts
            </h2>
            <div class="border-b border-(--color-border)">
                {posts.map((post) => post.collection === 'extern' ? (
                        <PostCard
                                title={post.data.title}
                                description={post.data.description}
                                date={post.data.date}
                                tags={[]}
                                slug={post.id}
                                external={post.data}
                        />
                ) : (
                        <PostCard
                                title={post.data.title}
                                description={post.data.description}
                                date={post.data.date}
                                tags={post.data.tags}
                                slug={post.id}
                                image={post.data.image}
                                podcastDuration={post.data.podcast?.duration}
                        />
                ))}
            </div>
            {posts.length === 0 && (
                    <p class="text-(--color-text-muted) py-8">Noch keine Posts vorhanden.</p>
            )}
        </section>

        {upcomingTalks.length > 0 && (
            <section id="talks" class="scroll-mt-20 pt-8 pb-8">
                <div class="mb-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h2 class="text-[1.875rem] leading-tight font-semibold tracking-[-0.02em]" style="font-variation-settings: 'opsz' 48">
                        Demnächst unterwegs
                    </h2>
                    <a href="/talks" class="font-mono text-[0.8125rem] tracking-[0.02em] text-(--color-accent) hover:text-(--color-accent-hover)">Alle Talks →</a>
                </div>
                <div class="border-b border-(--color-border)">
                    {upcomingTalks.map((talk) => <TalkRow talk={talk} />)}
                </div>
            </section>
        )}

        {featuredProjects.length > 0 && (
            <section id="projekte" class="scroll-mt-20 pt-8 pb-8">
                <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h2 class="text-[1.875rem] leading-tight font-semibold tracking-[-0.02em]" style="font-variation-settings: 'opsz' 48">
                        Woran ich baue
                    </h2>
                    <a href="/projekte" class="font-mono text-[0.8125rem] tracking-[0.02em] text-(--color-accent) hover:text-(--color-accent-hover)">Alle Projekte →</a>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    {featuredProjects.map((project) => <FeaturedProject project={project} />)}
                </div>
            </section>
        )}
    </div>
</BaseLayout>

<style>
    .hero-title {
        font-variation-settings: 'opsz' 96;
        font-weight: 750;
    }
    .hero-name {
        background: linear-gradient(transparent 62%, var(--color-signal-soft) 62%);
    }
    .hero-grid {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(var(--color-border-strong) 1px, transparent 1.4px);
        background-size: 24px 24px;
        opacity: 0.4;
        -webkit-mask-image: linear-gradient(115deg, transparent 35%, #000 80%);
        mask-image: linear-gradient(115deg, transparent 35%, #000 80%);
        pointer-events: none;
    }
</style>
