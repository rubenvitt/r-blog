---
// Hervorgehobenes Projekt als Karte: eine Signal-Markierung oben links, sonst ruhig.
import ProjectShot from './ProjectShot.astro';
import StatusBadge from './StatusBadge.astro';
import { KIND_LABEL, hostname, type Project } from '../../lib/projects';

interface Props {
    project: Project;
}

const { project } = Astro.props;
const { title, tagline, kind, status, website, app, screenshot, screenshotAlt } = project.data;
const external = website ?? app;
const label = external ? hostname(external) : project.data.repo;
---

<article class="featured-project relative flex flex-col overflow-hidden rounded-md border border-(--color-border) bg-(--color-bg-secondary) transition-colors hover:border-(--color-border-strong)">
    {!screenshot && (
        <div class="featured-cover border-b border-(--color-border)" aria-hidden="true">
            <div class="flex h-8 items-center gap-2 border-b border-(--color-border) bg-(--color-bg-secondary) px-3.5 font-mono text-xs tracking-[0.02em] text-(--color-text-secondary)">
                <span class="size-2 rounded-[1px] bg-(--color-signal)"></span>{label}
            </div>
            <div class="grid aspect-[16/9] place-items-center px-6">
                <span class="font-display text-[2rem] font-bold tracking-[-0.03em] text-(--color-border-strong)" style="font-variation-settings: 'opsz' 72">{title}</span>
            </div>
        </div>
    )}
    {screenshot && <ProjectShot src={screenshot} alt={screenshotAlt ?? `Screenshot von ${title}`} variant="card" focus={project.data.screenshotFocus} label={label} />}
    <div class="relative flex flex-1 flex-col gap-3 p-5">
    <span class="absolute top-0 left-5 h-[3px] w-8 bg-(--color-signal)" aria-hidden="true"></span>
    <div class="flex flex-wrap items-center gap-2">
        <StatusBadge status={status} />
        <span class="font-mono text-[0.8125rem] tracking-[0.02em] text-(--color-text-secondary)">{KIND_LABEL[kind]}</span>
    </div>
    <h3 class="text-[1.375rem] leading-[1.25] font-semibold tracking-[-0.015em]" style="font-variation-settings: 'opsz' 32">
        <a href={`/projekte/${project.id}`} class="text-(--color-text) no-underline after:absolute after:inset-0 after:content-['']">{title}</a>
    </h3>
    <p class="text-base leading-relaxed text-(--color-text-secondary)">{tagline}</p>
    {external && (
        <p class="mt-auto pt-1 font-mono text-[0.8125rem] tracking-[0.02em] text-(--color-accent)">↗ {hostname(external)}</p>
    )}
    </div>
</article>

<style>
    .featured-cover {
        background-color: var(--color-bg-sunken);
        background-image: radial-gradient(var(--color-border-strong) 1px, transparent 1.4px);
        background-size: 20px 20px;
        background-position: -10px -10px;
    }
</style>
