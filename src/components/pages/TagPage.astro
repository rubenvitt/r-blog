---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../ui/PostCard.astro';
import { alternatesFor, getLocale, localePath, useTranslations, type Locale } from '../../lib/i18n';
import { postSlug, type Post } from '../../lib/posts';

interface Props {
    tag: string;
    posts: Post[];
    locales: Locale[];
}

const {tag, posts, locales} = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
---

<BaseLayout title={`${tag} — rubeen.dev`} alternates={alternatesFor(`/tags/${tag}`, locales)}>
    <div class="mx-auto max-w-(--content-width) px-6 py-16">
        <div class="mb-8">
            <a href={localePath(locale, '/tags')} class="text-sm font-semibold text-(--color-accent) hover:underline underline-offset-4">{t('tags.all')}</a>
            <h1 class="mt-3 text-[2.75rem] leading-[1.1] font-bold tracking-[-0.03em]" style="font-variation-settings: 'opsz' 72"><span class="text-(--color-signal)">#</span>{tag}</h1>
            <p class="mt-2 font-mono text-[0.8125rem] tracking-[0.02em] text-(--color-text-secondary)">{posts.length} {posts.length === 1 ? t('tags.post') : t('tags.posts')}</p>
        </div>
        <div>
            {posts.map((post) => (
                    <PostCard
                            title={post.data.title}
                            description={post.data.description}
                            date={post.data.date}
                            tags={post.data.tags}
                            slug={postSlug(post)}
                            image={post.data.image}
                            podcastDuration={post.data.podcast?.duration}
                    />
            ))}
        </div>
    </div>
</BaseLayout>
