---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagBadge from '../ui/TagBadge.astro';
import { alternatesFor, getLocale, useTranslations } from '../../lib/i18n';
import { getTagCounts } from '../../lib/tags';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const sortedTags = await getTagCounts(locale);
---

<BaseLayout title={`${t('tags.title')} — rubeen.dev`} alternates={alternatesFor('/tags')}>
    <div class="mx-auto max-w-(--content-width) px-6 py-16">
        <h1 class="mb-8 text-[2.75rem] leading-[1.1] font-bold tracking-[-0.03em]" style="font-variation-settings: 'opsz' 72">{t('tags.title')}</h1>
        <div class="flex flex-wrap gap-2">
            {sortedTags.map(([tag, count]) => (
                    <TagBadge tag={tag} count={count}/>
            ))}
        </div>
        {sortedTags.length === 0 && (
                <p class="text-(--color-text-muted)">{t('tags.empty')}</p>
        )}
    </div>
</BaseLayout>
