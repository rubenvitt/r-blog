---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../ui/PostCard.astro';
import FeaturedProject from '../projects/FeaturedProject.astro';
import { getProjects } from '../../lib/projects';
import TalkRow from '../talks/TalkRow.astro';
import { getTalks, splitByDate } from '../../lib/talks';
import { alternatesFor, getLocale, localePath, useTranslations } from '../../lib/i18n';
import { getPosts, postSlug } from '../../lib/posts';

// Startseite für jede Sprache. Talks und Projekte gibt es nur auf Deutsch, darum nur dort.
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const isGerman = locale === 'de';
const blogPosts = await getPosts(locale);
// Artikel an anderer Stelle: auf Deutsch alle, sonst nur die in der jeweiligen Sprache.
const externalPosts = await getCollection('extern', ({data}) => isGerman || data.language === locale);
// Blogposts und Artikel an anderer Stelle in einer Liste, neueste zuerst.
const posts = [...blogPosts, ...externalPosts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredProjects = isGerman ? (await getProjects()).filter((p) => p.data.featured).slice(0, 4) : [];
const upcomingTalks = isGerman ? splitByDate(await getTalks()).upcoming.slice(0, 3) : [];
---

<BaseLayout title={t('home.title')} description={t('home.description')} alternates={alternatesFor('/')}>
    <div class="mx-auto max-w-(--content-width) px-4 sm:px-6">
        <!-- Hero: Lagekarten-Raster im Hintergrund, eine Markierung -->
        <section class="relative pt-20 pb-16 sm:pt-24">
            <div class="hero-grid" aria-hidden="true"></div>
            <p class="relative mb-4 font-mono text-[0.8125rem] tracking-[0.04em] text-(--color-text-secondary)">
                <span class="text-(--color-signal-text)">■</span> {t('home.kicker')}
            </p>
            <h1 class="hero-title relative text-[2.75rem] leading-[1.05] tracking-[-0.03em] sm:text-[4rem] sm:leading-none">
                {t('home.hello')} <span class="hero-name">Ruben.</span>
            </h1>
            <p class="hero-intro relative mt-6 max-w-[56ch] text-xl leading-relaxed text-(--color-text-secondary)">
                <Fragment set:html={t('home.intro')}/>
            </p>
            <div class="relative mt-8 flex flex-wrap items-center gap-3">
                <a href="#posts" class="inline-flex h-10 items-center rounded-md border border-(--color-accent) bg-(--color-accent) px-4 text-sm font-bold tracking-[0.01em] text-(--color-on-accent) transition-colors hover:border-(--color-accent-hover) hover:bg-(--color-accent-hover)">{t('home.readLatest')}</a>
                <a href="/projekte" hreflang={isGerman ? undefined : 'de'} class="inline-flex h-10 items-center rounded-md border border-(--color-border-strong) bg-(--color-bg-secondary) px-4 text-sm font-bold tracking-[0.01em] text-(--color-text) transition-colors hover:border-(--color-text)">{t('nav.projects')}</a>
                <a href={localePath(locale, '/about')} class="inline-flex h-10 items-center rounded-md border border-(--color-border-strong) bg-(--color-bg-secondary) px-4 text-sm font-bold tracking-[0.01em] text-(--color-text) transition-colors hover:border-(--color-text)">{t('nav.about')}</a>
            </div>
        </section>

        <!-- Post List -->
        <section id="posts" class="scroll-mt-20 pb-8">
            <h2 class="mb-2 text-[1.875rem] leading-tight font-semibold tracking-[-0.02em]" style="font-variation-settings: 'opsz' 48">
                {t('home.latest')}
            </h2>
            <div class="border-b border-(--color-border)">
                {posts.map((post) => post.collection === 'extern' ? (
                        <PostCard
                                title={post.data.title}
                                description={post.data.description}
                                date={post.data.date}
                                tags={[]}
                                slug={post.id}
                                external={post.data}
                        />
                ) : (
                        <PostCard
                                title={post.data.title}
                                description={post.data.description}
                                date={post.data.date}
                                tags={post.data.tags}
                                slug={postSlug(post)}
                                image={post.data.image}
                                podcastDuration={post.data.podcast?.duration}
                        />
                ))}
            </div>
            {posts.length === 0 && (
                    <p class="text-(--color-text-muted) py-8">{t('home.empty')}</p>
            )}
        </section>

        {upcomingTalks.length > 0 && (
            <section id="talks" class="scroll-mt-20 pt-8 pb-8">
                <div class="mb-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h2 class="text-[1.875rem] leading-tight font-semibold tracking-[-0.02em]" style="font-variation-settings: 'opsz' 48">
                        {t('home.upcoming')}
                    </h2>
                    <a href="/talks" class="font-mono text-[0.8125rem] tracking-[0.02em] text-(--color-accent) hover:text-(--color-accent-hover)">{t('home.allTalks')}</a>
                </div>
                <div class="border-b border-(--color-border)">
                    {upcomingTalks.map((talk) => <TalkRow talk={talk} />)}
                </div>
            </section>
        )}

        {featuredProjects.length > 0 && (
            <section id="projekte" class="scroll-mt-20 pt-8 pb-8">
                <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h2 class="text-[1.875rem] leading-tight font-semibold tracking-[-0.02em]" style="font-variation-settings: 'opsz' 48">
                        {t('home.building')}
                    </h2>
                    <a href="/projekte" class="font-mono text-[0.8125rem] tracking-[0.02em] text-(--color-accent) hover:text-(--color-accent-hover)">{t('home.allProjects')}</a>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    {featuredProjects.map((project) => <FeaturedProject project={project} />)}
                </div>
            </section>
        )}
    </div>
</BaseLayout>

<style>
    .hero-title {
        font-variation-settings: 'opsz' 96;
        font-weight: 750;
    }
    .hero-intro :global(a) {
        color: var(--color-text);
        text-decoration: underline;
        text-decoration-color: var(--color-border-strong);
        text-underline-offset: 3px;
        transition: color 0.15s, text-decoration-color 0.15s;
    }
    .hero-intro :global(a:hover) {
        color: var(--color-accent);
        text-decoration-color: var(--color-accent);
    }
    .hero-name {
        background: linear-gradient(transparent 62%, var(--color-signal-soft) 62%);
    }
    .hero-grid {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(var(--color-border-strong) 1px, transparent 1.4px);
        background-size: 24px 24px;
        opacity: 0.4;
        -webkit-mask-image: linear-gradient(115deg, transparent 35%, #000 80%);
        mask-image: linear-gradient(115deg, transparent 35%, #000 80%);
        pointer-events: none;
    }
</style>
