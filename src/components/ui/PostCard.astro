---
// Eintrag wie im Einsatztagebuch: Datum in fester Spalte links, Eintrag rechts.
interface Props {
    title: string;
    description: string;
    date: Date;
    tags: string[];
    slug: string;
    image?: ImageMetadata;
    podcastDuration?: string;
    /** Artikel an anderer Stelle: verlinkt nach außen statt auf /blog/<slug>. */
    external?: {url: string; publisher: string; coAuthors?: string[]; language?: 'de' | 'en'};
}

const {title, description, date, tags, slug, podcastDuration, external} = Astro.props;
const href = external ? external.url : `/blog/${slug}`;

const isoDate = date.toISOString().slice(0, 10);
---

<article class="post-card grid gap-x-6 gap-y-1 border-t border-(--color-border) py-6 sm:grid-cols-[7rem_1fr]">
    <time datetime={date.toISOString()} class="font-mono text-[0.8125rem] leading-[1.75rem] tracking-[0.02em] text-(--color-text-secondary) tabular-nums">
        {isoDate}
    </time>
    <div class="grid min-w-0 gap-2">
        <h3 class="text-[1.3125rem] leading-[1.3] font-semibold tracking-[-0.015em]" style="font-variation-settings: 'opsz' 24">
            <a href={href} hreflang={external?.language === 'en' ? 'en' : undefined} class="post-card-link text-(--color-text)">{title}</a>{external && <span class="text-(--color-text-muted)" aria-hidden="true"> ↗</span>}
        </h3>
        <p class="line-clamp-2 max-w-[62ch] text-base leading-relaxed text-(--color-text-secondary)">
            {description}
        </p>
        {external && (
            <p class="mt-1 font-mono text-[0.8125rem] tracking-[0.02em] text-(--color-text-secondary)">
                <span class="text-(--color-signal-text)">■</span> erschienen bei {external.publisher}{external.coAuthors?.length ? `, mit ${external.coAuthors.join(', ')}` : ''}{external.language === 'en' ? ' · auf Englisch' : ''}
            </p>
        )}
        {(tags.length > 0 || podcastDuration) && (
            <div class="mt-1 flex flex-wrap items-center gap-2">
                {podcastDuration && (
                    <span class="inline-flex items-center gap-1 font-mono text-[0.8125rem] text-(--color-accent)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 14v-2a9 9 0 0 1 18 0v2"/><path d="M21 15a2 2 0 0 1-2 2h-1v-6h1a2 2 0 0 1 2 2Z"/><path d="M3 15a2 2 0 0 0 2 2h1v-6H5a2 2 0 0 0-2 2Z"/></svg>
                        Podcast {podcastDuration}
                    </span>
                )}
                {tags.map((tag) => (
                    <a href={`/tags/${tag}`} class="relative z-10 inline-flex items-center rounded-[2px] border border-(--color-border) px-2 py-0.5 font-mono text-[0.8125rem] tracking-[0.02em] text-(--color-text-secondary) transition-colors hover:border-(--color-border-strong) hover:text-(--color-text)">
                        <span class="text-(--color-signal-text)">#</span>{tag}
                    </a>
                ))}
            </div>
        )}
    </div>
</article>

<style>
    .post-card-link {
        text-decoration: none;
        background-image: linear-gradient(var(--color-signal), var(--color-signal));
        background-size: 0 2px;
        background-position: 0 100%;
        background-repeat: no-repeat;
        transition: background-size 0.25s ease;
    }
    .post-card:hover .post-card-link,
    .post-card-link:focus-visible {
        background-size: 100% 2px;
    }
</style>
