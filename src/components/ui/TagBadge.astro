---
interface Props {
    tag: string;
    variant?: 'default' | 'hero';
    active?: boolean;
    count?: number;
}

const {tag, variant = 'default', active = false, count} = Astro.props;
---

{variant === 'hero' ? (
<a
        href={`/tags/${tag}`}
        class="inline-flex items-center rounded-[2px] border border-white/25 px-2 py-0.5 font-mono text-[0.8125rem] font-medium tracking-[0.02em] text-white/85 transition-colors hover:border-white/60 hover:text-white"
>
    <span class="text-(--color-signal)">#</span>{tag}
</a>
    ) : (
<a
        href={`/tags/${tag}`}
        aria-current={active ? 'page' : undefined}
        class:list={[
            'inline-flex items-center rounded-[2px] border px-2 py-0.5 font-mono text-[0.8125rem] font-medium tracking-[0.02em] transition-colors',
            active
                ? 'border-(--color-accent-soft) bg-(--color-accent-soft) text-(--color-accent)'
                : 'border-(--color-border) text-(--color-text-secondary) hover:border-(--color-border-strong) hover:text-(--color-text)',
        ]}
>
    <span class={active ? 'text-(--color-accent)' : 'text-(--color-signal-text)'}>#</span>{tag}
    {count != null && <span class="ml-2 text-(--color-text-muted)">{count}</span>}
</a>
    )}
