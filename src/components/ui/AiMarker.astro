---
// Kurzer KI-Hinweis in der Metazeile oben (Art. 50 Abs. 5 KI-VO: spätestens bei erster
// Wahrnehmung). Er verweist auf den ausführlichen Hinweis am Ende der Seite (AiDisclosure).
import { getLocale, useTranslations } from '../../lib/i18n';

interface Props {
    level: 'generated' | 'assisted' | 'none';
    /** Für Metazeilen auf dem dunklen Hero-Bild. */
    variant?: 'default' | 'hero';
}

const {level, variant = 'default'} = Astro.props;
const t = useTranslations(getLocale(Astro.url));
const label = {generated: t('ai.generated'), assisted: t('ai.assisted'), none: null}[level];
---

{label && (
    <a
        href="#ki-hinweis"
        class:list={[
            'underline decoration-dotted underline-offset-[3px] transition-colors',
            variant === 'hero' ? 'text-white/65 hover:text-white' : 'text-(--color-text-secondary) hover:text-(--color-accent)',
        ]}
    >
        {label}
    </a>
)}
