---
// Transparenzhinweis fuer KI-erzeugte Inhalte (Art. 50 Abs. 4 KI-VO), ausführlich am Ende
// der Seite. Art. 50 Abs. 5 verlangt "klar und eindeutig, spaetestens zum Zeitpunkt der ersten
// Wahrnehmung" — das leistet AiMarker in der Metazeile oben, der hierher verlinkt.
import {AI_TRANSPARENCY_PAGE, EDITORIAL_RESPONSIBILITY} from '../../lib/site';

interface Props {
    level: 'generated' | 'assisted' | 'none';
    /** Genitiv des Gegenstands, z. B. "dieser Projektbeschreibung". */
    subject?: string;
    /** Zusätzlicher Satz, z. B. zu einer KI-generierten Illustration. */
    note?: string;
}

const {level, subject, note} = Astro.props;

const config = {
    generated: {
        label: 'Mit KI erstellt',
        text: subject
            ? `Der Text ${subject} wurde mit generativer KI erzeugt.`
            : 'Text und Bilder dieses Artikels wurden mit generativer KI erzeugt.',
    },
    assisted: {
        label: 'Mit KI-Unterstützung',
        text: subject
            ? `Der Text ${subject} wurde mit generativer KI überarbeitet, etwa für Lektorat und Recherche.`
            : 'Dieser Artikel wurde mit generativer KI überarbeitet, etwa für Lektorat und Recherche.',
    },
    none: null,
};

const c = config[level];
const text = c && note ? `${c.text} ${note}` : c?.text;
---

{c && (
    <div
        id="ki-hinweis"
        class="not-prose mx-auto max-w-(--content-width) scroll-mt-20 px-6 pb-10"
        data-ai-disclosure={level}
    >
        <aside
            role="note"
            aria-label="Transparenzhinweis zu KI-generierten Inhalten"
            class="border-t border-(--color-border) pt-5"
        >
            <p class="text-[0.875rem] leading-relaxed text-(--color-text-secondary)">
                <strong class="mb-1 block font-mono text-[0.8125rem] font-bold tracking-[0.04em] text-(--color-text-secondary) uppercase">{c.label}</strong>
                {text} Redaktionelle Verantwortung: {EDITORIAL_RESPONSIBILITY}.{' '}
                <a href={AI_TRANSPARENCY_PAGE.path} class="text-(--color-accent) underline underline-offset-[3px] hover:text-(--color-accent-hover)">
                    Wie dieser Blog KI einsetzt
                </a>
            </p>
        </aside>
    </div>
)}
