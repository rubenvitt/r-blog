        pending: 'Dette steget endrer skjemaet ugjenkallelig.',
        review: 'Sjekk & godkjenn',
        question: 'Hvordan har du sjekket dette?',
        required: '(påkrevd)',
        placeholder: 'f.eks. backup fra 14:02 verifisert, kolonnen ubrukt siden v3',
        approve: 'Godkjenn',
        cancel: 'Avbryt',
        noReason: 'Ingen begrunnelse, ingen godkjenning.',
        approved: 'Godkjent av deg',
