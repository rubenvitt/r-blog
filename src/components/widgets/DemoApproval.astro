        required: '(obligatoire)',
        placeholder: 'p. ex. backup de 14:02 vérifié, colonne inutilisée depuis la v3',
        approve: 'Valider',
        cancel: 'Annuler',
        noReason: 'Pas de justification, pas de validation.',
        approved: 'Validé par vous',
        wouldRun: "Le tool call s'exécuterait maintenant - simplement esquissé ici, aucune vraie migration.",
        reset: 'Réinitialiser',
        quoteOpen: '« ',
        quoteClose: ' »',
    },
    nl: {
        header: 'Goedkeuring vereist · Tool-call',
        risk: 'high-risk · onomkeerbaar',
        pending: 'Deze stap verandert het schema onherroepelijk.',
        review: 'Controleren & goedkeuren',
        question: 'Waarmee heb je dit gecontroleerd?',
        required: '(verplicht)',
        placeholder: 'bijv. back-up van 14:02 geverifieerd, kolom sinds v3 ongebruikt',
        approve: 'Goedkeuren',
        cancel: 'Annuleren',
