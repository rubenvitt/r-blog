        risk: 'high-risk · oåterkallelig',
        pending: 'Det här steget ändrar schemat oåterkalleligt.',
        review: 'Granska & godkänn',
        question: 'Hur har du kontrollerat det?',
        required: '(obligatoriskt)',
        placeholder: 't.ex. backup från 14:02 verifierad, kolumnen oanvänd sedan v3',
        approve: 'Godkänn',
        cancel: 'Avbryt',
        noReason: 'Ingen motivering, inget godkännande.',
        approved: 'Godkänt av dig',
        wouldRun: 'Tool-callet skulle köras nu – här bara antytt, ingen riktig migration.',
        reset: 'Återställ',
