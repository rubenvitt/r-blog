		user: 'Nutzer',
		userSub: 'kricht Antwort',
		compareTag: 'VERGLEICH · GELOGGTE PAARE',
		metrics: 'Metriken',
		divergence: 'Tool-Call-Divergenz',
		quality: 'Antwort-Qualität (LLM-Judge)',
		cost: 'Token-Kosten pro Vorgang',
