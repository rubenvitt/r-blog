---
// Sprachwahl im Header. Echte Links (crawlbar, funktionieren ohne JS); die Wahl landet in
// localStorage 'locale' und gewinnt danach gegen die Browser-Sprache (siehe BaseLayout).
import { LOCALES, LOCALE_INFO, localePath, getLocale, useTranslations, type Alternates } from '../../lib/i18n';

interface Props {
    alternates: Alternates;
}

const {alternates} = Astro.props;
const current = getLocale(Astro.url);
const t = useTranslations(current);
const items = LOCALES.map((locale) => ({
    locale,
    ...LOCALE_INFO[locale],
    href: alternates[locale] ?? localePath(locale, '/'),
    missing: !alternates[locale],
}));
const main = items.filter((i) => i.locale !== 'pott');
const fun = items.find((i) => i.locale === 'pott')!;
---

<button
        id="lang-trigger"
        type="button"
        popovertarget="lang-menu"
        aria-label={t('lang.button')}
        class="ml-0.5 inline-flex h-8 shrink-0 items-center gap-1.5 rounded-md border border-(--color-border) px-2 font-mono text-[0.8125rem] font-bold tracking-[0.04em] text-(--color-text-secondary) transition-colors hover:border-(--color-border-strong) hover:text-(--color-text) sm:ml-1 sm:h-9 sm:px-2.5"
>
    <svg class="max-sm:hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M2 12h20"></path>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    {LOCALE_INFO[current].short}
</button>

<div id="lang-menu" popover class="lang-menu" data-current={current}>
    <button type="button" class="lang-item" data-locale="auto">
        <span class="lang-check" aria-hidden="true"></span>
        <span class="grid">
            <span class="lang-label">{t('lang.auto')}</span>
            <span class="lang-hint">{t('lang.autoHint')}</span>
        </span>
    </button>
    <hr/>
    {main.map((i) => (
        <a href={i.href} hreflang={i.htmlLang} lang={i.htmlLang} class="lang-item" data-locale={i.locale}
           aria-current={i.locale === current ? 'page' : undefined}>
            <span class="lang-check" aria-hidden="true"></span>
            <span class="grid">
                <span class="lang-label">{i.label}</span>
                {i.missing && <span class="lang-hint" lang={LOCALE_INFO[current].htmlLang}>→ {t('lang.missing')}</span>}
            </span>
            <span class="lang-code">{i.short}</span>
        </a>
    ))}
    <hr/>
    <a href={fun.href} lang="de" rel="nofollow" class="lang-item" data-locale={fun.locale}
       aria-current={fun.locale === current ? 'page' : undefined}>
        <span class="lang-check" aria-hidden="true"></span>
        <span class="grid">
            <span class="lang-label">{fun.label} <span aria-hidden="true">⚒</span></span>
            <span class="lang-hint">Glück auf, Kumpel</span>
        </span>
        <span class="lang-code">{fun.short}</span>
    </a>
</div>

<script>
const trigger = document.getElementById('lang-trigger');
const menu = document.getElementById('lang-menu');

function stored() {
    try { return localStorage.getItem('locale'); } catch { return null; }
}

function markChoice() {
    const choice = stored() ?? 'auto';
    menu?.querySelectorAll<HTMLElement>('.lang-item').forEach((el) => {
        el.toggleAttribute('data-chosen', el.dataset.locale === choice);
    });
}

// Popover liegt im Top Layer; unter dem Button rechtsbündig ausrichten.
menu?.addEventListener('beforetoggle', (e) => {
    if ((e as ToggleEvent).newState !== 'open' || !trigger) return;
    const r = trigger.getBoundingClientRect();
    menu.style.top = `${r.bottom + 8}px`;
    menu.style.right = `${Math.max(8, window.innerWidth - r.right)}px`;
    markChoice();
});

menu?.addEventListener('click', (e) => {
    const item = (e.target as HTMLElement).closest<HTMLElement>('.lang-item');
    if (!item) return;
    const locale = item.dataset.locale!;
    if (locale === 'auto') {
        try { localStorage.removeItem('locale'); } catch {}
        // Browser-Sprache bestimmen und dorthin gehen, sofern es die Seite dort gibt.
        const detected = (window as any).__detectLocale?.() as string | undefined;
        const target = menu.querySelector<HTMLAnchorElement>(`a[data-locale="${detected}"]`);
        if (target && detected !== menu.dataset.current && !target.querySelector('.lang-hint')) {
            location.href = target.href;
        } else {
            markChoice();
            menu.hidePopover();
        }
        return;
    }
    try { localStorage.setItem('locale', locale); } catch {}
});
</script>

<style>
    .lang-menu {
        inset: auto;
        position: fixed;
        margin: 0;
        width: min(17rem, calc(100vw - 16px));
        padding: 0.375rem;
        border: 1px solid var(--color-border);
        border-radius: 10px;
        background: color-mix(in srgb, var(--color-bg-secondary) 96%, transparent);
        backdrop-filter: blur(16px) saturate(1.4);
        -webkit-backdrop-filter: blur(16px) saturate(1.4);
        color: var(--color-text);
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 12px 32px -8px rgb(0 0 0 / 0.25);
        opacity: 0;
        transform: translateY(-6px) scale(0.98);
        transform-origin: top right;
        transition: opacity 0.16s ease, transform 0.16s ease, overlay 0.16s allow-discrete, display 0.16s allow-discrete;
    }
    .lang-menu:popover-open {
        opacity: 1;
        transform: none;
    }
    @starting-style {
        .lang-menu:popover-open {
            opacity: 0;
            transform: translateY(-6px) scale(0.98);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .lang-menu { transition: none; }
    }
    .lang-menu hr {
        margin: 0.25rem 0.5rem;
        border: 0;
        border-top: 1px solid var(--color-border);
    }
    .lang-item {
        display: grid;
        grid-template-columns: 1rem 1fr auto;
        align-items: center;
        gap: 0.625rem;
        width: 100%;
        padding: 0.5rem 0.625rem;
        border-radius: 6px;
        text-align: left;
        text-decoration: none;
        color: var(--color-text);
        cursor: pointer;
        transition: background-color 0.12s ease;
    }
    .lang-item:hover,
    .lang-item:focus-visible {
        background: var(--color-bg-sunken);
        outline: none;
    }
    .lang-item:focus-visible {
        box-shadow: inset 0 0 0 2px var(--color-accent);
    }
    .lang-item[aria-current='page'] {
        background: var(--color-accent-soft);
    }
    .lang-item[aria-current='page'] .lang-label {
        color: var(--color-accent);
    }
    .lang-label {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.9375rem;
        line-height: 1.3;
    }
    .lang-hint {
        font-size: 0.75rem;
        line-height: 1.35;
        color: var(--color-text-muted);
    }
    .lang-code {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        color: var(--color-text-muted);
    }
    /* Gespeicherte Wahl (oder „Automatisch“): Markierung im Lagebild-Stil */
    .lang-check::before {
        content: '';
        display: block;
        width: 0.5rem;
        height: 0.5rem;
        margin: auto;
        border: 1.5px solid var(--color-border-strong);
        border-radius: 1px;
    }
    .lang-item[data-chosen] .lang-check::before {
        border-color: var(--color-signal);
        background: var(--color-signal);
    }
</style>
