---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';

const currentPath = Astro.url.pathname;

const navLinks = [
    {href: '/', label: 'Blog'},
    {href: '/projekte', label: 'Projekte'},
    // Auf schmalen Displays fehlt der Platz für alle Links: Talks, Tags und Über mich bleiben über Startseite und Posts erreichbar.
    {href: '/talks', label: 'Talks', hide: 'max-sm:hidden'},
    {href: '/tags', label: 'Tags', hide: 'max-sm:hidden'},
    {href: '/about', label: 'Über mich', hide: 'max-[400px]:hidden'},
];
---

<header class="sticky top-0 z-50 border-b border-(--color-border) bg-(--color-bg)/85 backdrop-blur-lg">
    <nav class="mx-auto flex max-w-(--content-width-wide) items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a href="/" class="group flex shrink-0 items-center gap-2 font-display text-lg sm:gap-2.5 sm:text-xl font-bold tracking-[-0.03em] text-(--color-text)" style="font-variation-settings: 'opsz' 24">
            <Image src={logo} alt="" width={32} height={32} class="h-8 w-8 rounded-full object-cover ring-2 ring-(--color-signal) ring-offset-2 ring-offset-(--color-bg)"/>
            <span>rubeen<span class="hidden font-medium text-(--color-text-secondary) min-[420px]:inline">.dev</span></span>
        </a>

        <div class="flex items-center gap-0 sm:gap-2">
            {navLinks.map((link) => {
                const isActive = link.href === '/'
                    ? currentPath === '/' || currentPath.startsWith('/blog')
                    : currentPath.startsWith(link.href);
                return (
                    <a
                            href={link.href}
                            aria-current={isActive ? 'page' : undefined}
                            class:list={[
                                link.hide,
                                'whitespace-nowrap px-1.5 py-2 text-sm font-semibold transition-colors sm:px-3 sm:text-[0.9375rem]',
                                isActive
                                    ? 'text-(--color-accent) shadow-[inset_0_-2px_0_var(--color-accent)]'
                                    : 'rounded-md text-(--color-text-secondary) hover:bg-(--color-bg-sunken) hover:text-(--color-text)',
                            ]}
                    >
                        {link.label}
                    </a>
                );
            })}

            <button
                    id="search-trigger"
                    class="ml-0.5 grid h-8 w-8 shrink-0 place-items-center sm:ml-1 sm:h-9 sm:w-9 rounded-md border border-(--color-border) text-(--color-text-secondary) transition-colors hover:border-(--color-border-strong) hover:text-(--color-text)"
                    aria-label="Suche"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.3-4.3"></path>
                </svg>
            </button>

            <button
                    id="theme-toggle"
                    class="ml-0.5 grid h-8 w-8 shrink-0 place-items-center sm:ml-1 sm:h-9 sm:w-9 rounded-md border border-(--color-border) text-(--color-text-secondary) transition-colors hover:border-(--color-border-strong) hover:text-(--color-text)"
                    aria-label="Theme wechseln"
            >
                <svg class="icon-system" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
                <svg class="icon-light" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2"></path>
                    <path d="M12 20v2"></path>
                    <path d="m4.93 4.93 1.41 1.41"></path>
                    <path d="m17.66 17.66 1.41 1.41"></path>
                    <path d="M2 12h2"></path>
                    <path d="M20 12h2"></path>
                    <path d="m6.34 17.66-1.41 1.41"></path>
                    <path d="m19.07 4.93-1.41 1.41"></path>
                </svg>
                <svg class="icon-dark" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                </svg>
            </button>

        </div>
    </nav>
</header>

<script>
const toggle = document.getElementById('theme-toggle');

function getStoredTheme() {
    return localStorage.getItem('theme');
}

function applyTheme() {
    const stored = getStoredTheme();
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const effective = stored || (prefersDark ? 'dark' : 'light');
    document.documentElement.classList.toggle('dark', effective === 'dark');
    document.documentElement.setAttribute('data-theme', stored || 'system');
}

// Toggle: system → light → dark → system
toggle?.addEventListener('click', () => {
    const stored = getStoredTheme();
    if (!stored) {
        localStorage.setItem('theme', 'light');
    } else if (stored === 'light') {
        localStorage.setItem('theme', 'dark');
    } else {
        localStorage.removeItem('theme');
    }
    applyTheme();
});

// React to system preference changes in real-time
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (!getStoredTheme()) {
        applyTheme();
    }
});

applyTheme();
</script>
